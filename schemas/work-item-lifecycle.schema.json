{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supervised-project.local/schemas/work-item-lifecycle.schema.json",
  "title": "Supervised work item lifecycle policy",
  "type": "object",
  "required": [
    "schema_version",
    "catalog_version",
    "base_states",
    "type_policies",
    "dependency_rules",
    "propagation_rules",
    "execution_constraints"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "base_states": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/work_state"}
    },
    "type_policies": {
      "type": "object",
      "required": ["module", "event", "subtask"],
      "properties": {
        "module": {"$ref": "#/$defs/type_policy"},
        "event": {"$ref": "#/$defs/type_policy"},
        "subtask": {"$ref": "#/$defs/type_policy"}
      },
      "additionalProperties": false
    },
    "dependency_rules": {"$ref": "#/$defs/string_map"},
    "propagation_rules": {"$ref": "#/$defs/string_map"},
    "execution_constraints": {"$ref": "#/$defs/string_map"}
  },
  "$defs": {
    "work_state": {
      "enum": [
        "not_started",
        "queued",
        "active",
        "awaiting_review",
        "paused",
        "blocked",
        "complete",
        "failed",
        "cancelled",
        "skipped_with_evidence",
        "superseded"
      ]
    },
    "transition_edge": {
      "type": "object",
      "required": ["from", "to", "decision", "guards"],
      "properties": {
        "from": {"$ref": "#/$defs/work_state"},
        "to": {"$ref": "#/$defs/work_state"},
        "decision": {"enum": ["controller", "user_approval", "cr"]},
        "guards": {
          "type": "array",
          "items": {"type": "string", "pattern": "^G-[A-Z0-9-]+$"}
        }
      },
      "additionalProperties": false
    },
    "completion_disposition": {
      "type": "object",
      "required": ["allowed"],
      "properties": {
        "allowed": {"type": "boolean"},
        "approval": {"enum": ["never", "when_required", "always", "cr_or_replacement"]}
      },
      "additionalProperties": false
    },
    "type_policy": {
      "type": "object",
      "required": ["states", "terminal_states", "acceptable_for_parent_completion", "transitions"],
      "properties": {
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/work_state"}
        },
        "terminal_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/work_state"}
        },
        "acceptable_for_parent_completion": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/completion_disposition"}
        },
        "transitions": {
          "type": "array",
          "items": {"$ref": "#/$defs/transition_edge"}
        }
      },
      "additionalProperties": false
    },
    "string_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  },
  "unevaluatedProperties": false
}
